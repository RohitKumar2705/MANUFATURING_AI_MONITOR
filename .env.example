# Copy this file to `.env` and adjust as needed. Most settings live in
# config.yaml instead - these are the few that are commonly overridden per
# environment (deployment machine, demo laptop, etc).

# Set to "false" to require real camera sources only (no synthetic fallback
# camera generation). Defaults to true.
DEMO_MODE=true

# Admin login (see app/core/auth.py). Default demo password is
# "novatech123" - change DEFAULT_PASSWORD_HASH in app/core/auth.py for any
# real deployment; this .env value is illustrative only in this prototype.
ADMIN_USERNAME=admin

# Uvicorn bind address/port (also settable in config.yaml under app.host/app.port)
HOST=0.0.0.0
PORT=8000
